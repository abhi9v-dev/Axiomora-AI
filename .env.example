# Copy this file to .env and fill in real values locally.
# Never commit .env or any file containing real secrets/connection strings.

# --- General ---
APP_ENV=development

# --- Application database (runs, audit, catalog/pgvector) ---
# Matches the credentials created for the `db` service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://bi_app:changeme@localhost:5432/bi_copilot

# --- Analytical warehouse (read-only role; same instance in local dev, Phase 1+) ---
WAREHOUSE_URL=postgresql+asyncpg://bi_readonly:changeme@localhost:5432/bi_copilot

# --- LLM provider ---
# LLM_PROVIDER=fake uses the deterministic FakeLLMProvider (no network, no cost).
# Set LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY for live model runs
# -- this is a real, metered Claude API call; it is never free (docs/04_TRT.md).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Embeddings ---
EMBEDDING_PROVIDER=fake

# --- SQL / validator policy (Phase 4+) ---
MAX_SQL_REPAIRS=2
QUERY_TIMEOUT_MS=10000
QUERY_ROW_LIMIT=5000

# --- Orchestrator clarification thresholds (Phase 6+) ---
# Below these, a run pauses at NEEDS_CLARIFICATION instead of guessing.
RETRIEVAL_MIN_SCORE=0.2
NL2SQL_MIN_CONFIDENCE=0.4

# --- Power BI adapter (Phase 8+; keep disabled by default) ---
# POWER_BI_ENABLED gates whether power_bi_push/power_bi_refresh actions
# are offered at all -- app.action.policy always rejects them when false,
# regardless of POWER_BI_ADAPTER.
POWER_BI_ENABLED=false
# POWER_BI_ADAPTER=mock uses the deterministic MockPowerBIAdapter (no
# network, no cost, no tenant needed) -- what CI and local demos use.
# Set POWER_BI_ADAPTER=rest and the four fields below for real, metered
# Power BI REST calls via a Microsoft Entra app registration
# (docs/09_DEPLOYMENT_OPERATIONS.md's "Power BI reality check").
POWER_BI_ADAPTER=mock
POWER_BI_WORKSPACE_ID=demo-workspace
POWER_BI_DATASET_ID=demo-dataset
POWER_BI_TABLE_NAME=BiCopilotInsights
POWER_BI_TENANT_ID=
POWER_BI_CLIENT_ID=
POWER_BI_CLIENT_SECRET=

# --- API service ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API (the web app dev origin).
CORS_ORIGINS=http://localhost:3000

# --- Web app (Next.js public config; NEXT_PUBLIC_* is exposed to the browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Build-time UI gate for the Power BI action buttons (docs/05_FRONTEND_UX.md:
# "Publish to Power BI when enabled"). Keep this in sync with the API's
# POWER_BI_ENABLED -- the API also enforces the flag server-side regardless
# of what the UI shows.
NEXT_PUBLIC_POWER_BI_ENABLED=false
